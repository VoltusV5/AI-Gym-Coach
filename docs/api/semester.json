{
  "openapi": "3.0.3",
  "info": {
    "title": "Спортик — контракт нового семестра",
    "version": "2026.10.05-2"
  },
  "servers": [
    {
      "url": "/proxy/backend",
      "description": "Локальный Go через сервер Swagger: порт 5050"
    },
    {
      "url": "http://localhost:5050",
      "description": "Прямой локальный Go (нужен CORS)"
    }
  ],
  "paths": {
    "/v2/recommendations/rank": {
      "post": {
        "operationId": "ml_plan_post_v2_recommendations_rank",
        "summary": "Ранжировать допустимые программы",
        "description": "**Проектируется, пока не реализовано.** Content-based/collaborative гибрид, cold start по профилю. Id только из candidates. Go проверяет публикацию/доступ перед показом. Предлагаемый deadline 1 секунда, p95 ≤500 мс; fallback совместимые правила/cache.",
        "tags": [
          "ML · Семестр"
        ],
        "x-status": "planned",
        "x-service": "ml-plan",
        "servers": [
          {
            "url": "/proxy/ml-plan",
            "description": "Локальный ML через Swagger server"
          },
          {
            "url": "http://localhost:8000",
            "description": "Прямой ML, требует CORS"
          }
        ],
        "security": [
          {
            "ServiceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MLRankInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLRankResult"
                }
              }
            }
          },
          "422": {
            "description": "Невалидные признаки или нет допустимого результата",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLError"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка загрузки модели, inference или формирования ответа",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Модель/зависимость недоступна",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v2/recommendations/explain": {
      "post": {
        "operationId": "ml_plan_post_v2_recommendations_explain",
        "summary": "Объяснить рекомендацию по фактам",
        "description": "**Проектируется, пока не реализовано.** RAG/LLM не определяет право доступа и не выдумывает facts. Только evidence и разрешённый контекст. Предлагаемый deadline 3 секунды; p95 ≤2 секунды. При ошибке шаблонное объяснение.",
        "tags": [
          "ML · Семестр"
        ],
        "x-status": "planned",
        "x-service": "ml-plan",
        "servers": [
          {
            "url": "/proxy/ml-plan",
            "description": "Локальный ML через Swagger server"
          },
          {
            "url": "http://localhost:8000",
            "description": "Прямой ML, требует CORS"
          }
        ],
        "security": [
          {
            "ServiceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MLExplainInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLExplainResult"
                }
              }
            }
          },
          "422": {
            "description": "Невалидные признаки или нет допустимого результата",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLError"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка загрузки модели, inference или формирования ответа",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Модель/зависимость недоступна",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MLError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Служебный токен Go ↔ ML; не пользовательский JWT"
      }
    },
    "schemas": {
      "MLHistory": {
        "type": "object",
        "properties": {
          "completed_28d": {
            "type": "integer"
          },
          "adherence_28d": {
            "type": "number",
            "nullable": true
          },
          "exercise_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exercise_id": {
                  "type": "integer"
                },
                "weight_kg": {
                  "type": "number"
                },
                "reps": {
                  "type": "integer"
                },
                "volume_kg": {
                  "type": "number"
                },
                "measured_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "MLCandidate": {
        "type": "object",
        "properties": {
          "program_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "sessions_per_week": {
            "type": "integer"
          },
          "equipment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "program_id",
          "version_id",
          "level",
          "goal",
          "sessions_per_week",
          "equipment_ids"
        ]
      },
      "MLRankInput": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "feature_schema_version": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string"
              },
              "goal": {
                "type": "string"
              },
              "sessions_per_week": {
                "type": "integer"
              },
              "equipment_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "progress": {
                "$ref": "#/components/schemas/MLHistory"
              },
              "behavior": {
                "type": "object",
                "properties": {
                  "viewed_program_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "saved_program_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "purchased_program_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "ratings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "program_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "overall": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MLCandidate"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "request_id",
          "feature_schema_version",
          "context",
          "candidates",
          "limit"
        ]
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "sessions_per_week": {
            "type": "integer"
          },
          "level": {
            "type": "string"
          },
          "equipment_match": {
            "type": "boolean"
          },
          "goal_match": {
            "type": "boolean"
          }
        }
      },
      "MLRankItem": {
        "type": "object",
        "properties": {
          "program_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "score": {
            "type": "number"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          }
        },
        "required": [
          "program_id",
          "version_id",
          "score",
          "reason_codes",
          "evidence"
        ]
      },
      "MLRankResult": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MLRankItem"
            }
          },
          "fallback": {
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "model_version",
          "items",
          "fallback"
        ]
      },
      "MLExplainInput": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "program_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "$ref": "#/components/schemas/Evidence"
                },
                "allowed_context": {
                  "type": "object",
                  "properties": {
                    "program_description": {
                      "type": "string"
                    },
                    "user_summary": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "program_id",
                "version_id",
                "reason_codes",
                "evidence"
              ]
            }
          }
        },
        "required": [
          "request_id",
          "locale",
          "items"
        ]
      },
      "MLExplainResult": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "program_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "text": {
                  "type": "string"
                },
                "source_version_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "explanation_mode": {
                  "type": "string",
                  "enum": [
                    "rag",
                    "template"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "request_id",
          "items"
        ]
      },
      "MLError": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "request_id",
          "error"
        ]
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "externalDocs": {
    "description": "Официальная документация Swagger / OpenAPI",
    "url": "https://swagger.io/docs/specification/v3_0/about/"
  },
  "x-conventions": {
    "ids": "Новые UUID, существующие users/exercises integer",
    "time": "RFC3339 UTC; calendar date YYYY-MM-DD, IANA time_zone",
    "money": "Целые минимальные единицы; RUB — копейки",
    "commission_bps": 2000,
    "review_required_workouts": 3,
    "idempotency": "Для v2 заказа, генерации, Fork, complete и выплаты обязателен Idempotency-Key. Тот же ключ+тело возвращает исходный результат, другое тело 409; хранение минимум 24 часа — проектный параметр. provider_event_id дедуплицируется независимо."
  },
  "tags": [
    {
      "name": "ML · Семестр"
    }
  ]
}
